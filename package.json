{
  "name": "microapps-ecosystem",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "turbo run lint --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "test": "turbo run test --concurrency=4",
    "build": "turbo run build --concurrency=4",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,md,json,js}": [
      "prettier --write"
    ]
  }
}
