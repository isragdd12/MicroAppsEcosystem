# Copy to supabase/.env (gitignored) and fill in real values.
# Never commit this file with real secrets.

# Google OAuth — from Google Cloud Console credentials for this project.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Twilio (SMS auth) — not enabled for Milestone 1, placeholder for later.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
